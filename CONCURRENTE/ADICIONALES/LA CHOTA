programa parcial17
procesos 
  proceso juntarTodo (ES p:numero; ES f:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      p:= p + 1
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
  fin
  proceso avanzar (E aux:numero; ES p:numero; ES f:numero)
  comenzar
    repetir aux
      juntarTodo(p,f)
      mover
    juntarTodo(p,f)
  fin
  proceso orientar (E aux:numero)
  comenzar
    repetir aux
      derecha
  fin
  proceso depositar 
  comenzar
    si (HayFlorEnLaBolsa)
      depositarFlor
    si (HayPapelEnLaBolsa)
      depositarPapel
  fin
  proceso avanzoDeposito (E aux:numero)
  comenzar
    repetir aux
      depositar
      mover
    depositar
  fin 
areas
  area:AreaC(1,1,17,7)
robots
  robot corredor1
  variables
    f,p,cant:numero
  comenzar
    f:=0
    p:=0 
    orientar(1)
    avanzar(4,p,f)
    BloquearEsquina(PosAv + 1, PosCa)
    mover
    juntarTodo(p,f)
    orientar(3)
    mover
    LiberarEsquina(PosAv,PosCa - 1)
    avanzar(3,p,f)
    cant:= p + f
    Informar('TOTAL',cant)
    orientar(2)
    avanzoDeposito(3)
    BloquearEsquina(PosAv, PosCa + 1)
    mover
    depositar
    orientar(1)
    mover
    LiberarEsquina(PosAv - 1,PosCa)
    avanzoDeposito(4)
  fin
  robot corredor2
  variables 
    f,p,cant:numero
  comenzar
    f:=0
    p:=0 
    orientar(3)
    avanzar(3,p,f)
    BloquearEsquina(PosAv - 1, PosCa)
    mover
    juntarTodo(p,f)
    orientar(3)
    mover
    LiberarEsquina(PosAv, PosCa - 1)
    avanzar(3,p,f)
    cant:= p + f
    Informar('TOTAL',cant)
    orientar(2)
    avanzar(3,p,f)
    BloquearEsquina(PosAv, PosCa + 1)
    mover
    juntarTodo(p,f)
    orientar(1)
    mover
    LiberarEsquina(PosAv - 1,PosCa)
    avanzar(3,p,f)
  fin
variables
  robot1:corredor1
  robot2:corredor2
comenzar
  AsignarArea(robot1,area)
  AsignarArea(robot2,area)
  Iniciar(robot1,1,5)
  Iniciar(robot2,9,5)
fin

