programa parcial9
procesos
  proceso juntarPapeles (ES p:numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      p:= p + 1
  fin
  proceso juntarFlores (ES f:numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
  fin
  proceso enviarID
  comenzar
    EnviarMensaje(1,robot1)
    EnviarMensaje(2,robot2)
    EnviarMensaje(3,robot3)
    EnviarMensaje(4,robot4)
  fin
areas
  equipo1:AreaPC(2,1,3,1)
  equipo2:AreaPC(4,1,5,1)
  areaJefe:AreaP(1,1,1,1)
  horizontal1:AreaP(6,5,15,5)
  horizontal2:AreaP(26,5,35,5)
  vertical1:AreaP(5,6,5,20)
  vertical2:AreaP(25,6,25,20)
  esquina1:AreaPC(5,5,5,5)
  esquina2:AreaPC(25,5,25,5)
robots
  robot vertical 
  variables
    id,f,av,ca:numero
  comenzar
    RecibirMensaje(id,robotJefe)
    f:=0
    ca:= 5
    si (id = 1)
      av:= 5
    sino
      av:= 25
    BloquearEsquina(av,ca)
    Pos(av,ca)
    juntarFlores(f)
    mover
    LiberarEsquina(av,ca)
    repetir 14
      juntarFlores(f)
      mover
    juntarFlores(f)
    EnviarMensaje(id,robotJefe)
    EnviarMensaje(f,robotJefe)
  fin
  robot horizontal 
  variables
    av,ca,p,id:numero
  comenzar
    RecibirMensaje(id,robotJefe)
    derecha
    p:=0
    ca:= 5
    si (id = 2)
      av:= 5
    sino 
      av:= 25
    BloquearEsquina(av,ca)
    Pos(av,ca)
    juntarPapeles(p)
    mover
    LiberarEsquina(av,ca)
    repetir 9
      juntarPapeles(p)
      mover
    juntarPapeles(p)
    EnviarMensaje(id,robotJefe)
    EnviarMensaje(p,robotJefe)
  fin
  robot jefe
  variables
    eq1,eq2,id,cant:numero
  comenzar
    enviarID
    eq1:=0
    eq2:=0
    repetir 4
      RecibirMensaje(id,*)
      si (id = 1)
        RecibirMensaje(cant,robot1)
        eq1 := eq1 + cant
      sino
        si (id = 2)
          RecibirMensaje(cant,robot2)
          eq1 := eq1 + cant
        sino
          si (id = 3)
            RecibirMensaje(cant,robot3)
            eq2 := eq2 + cant
          sino
            RecibirMensaje(cant,robot4)
            eq2 := eq2 + cant
    si (eq1 > eq2)
      Informar(1)
    sino
      Informar(2)
  fin  
variables
  robot1,robot3:vertical
  robot2,robot4:horizontal
  robotJefe:jefe
comenzar
  AsignarArea(robot1,equipo1)
  AsignarArea(robot2,equipo1)
  AsignarArea(robot3,equipo2)
  AsignarArea(robot4,equipo2)
  AsignarArea(robot1,esquina1)
  AsignarArea(robot2,esquina1)
  AsignarArea(robot3,esquina2)
  AsignarArea(robot4,esquina2)
  AsignarArea(robot1,vertical1)
  AsignarArea(robot3,vertical2)
  AsignarArea(robot2,horizontal1)
  AsignarArea(robot4,horizontal2)
  AsignarArea(robotJefe,areaJefe)
  Iniciar(robot1,2,1)
  Iniciar(robot2,3,1)
  Iniciar(robot3,4,1)
  Iniciar(robot4,5,1)
  Iniciar(robotJefe,1,1)
fin
