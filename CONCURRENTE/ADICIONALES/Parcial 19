programa parcialValen
procesos 
  proceso deposito (ES aux:numero; E avIn:numero; E caIn:numero; E id:numero)
  comenzar 
    BloquearEsquina(50,50)
    Pos(50,50)
    repetir aux
      depositarPapel
    Pos(avIn,caIn)
    LiberarEsquina(50,50)
    EnviarMensaje(id,robotAcumulador)
    EnviarMensaje(aux,robotAcumulador)
  fin
  proceso juntarPapeles (ES p:numero; ES aux:numero)
  comenzar 
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      p:= p + 1
      aux:= aux + 1
  fin
areas
  area1:AreaP(1,1,16,16)
  area2:AreaP(30,1,45,16)
  areaAcumulador:AreaP(100,100,100,100)
  deposito:AreaC(50,50,50,50)
robots
  robot recolector
  variables
    id,p,aux,avIn,caIn:numero
  comenzar
    p:=0
    RecibirMensaje(id,robotAcumulador)
    repetir 4
      aux:=0
      repetir 14
        juntarPapeles(p,aux) 
        mover
      derecha
      juntarPapeles(p,aux)
      avIn:= PosAv
      caIn:= PosCa
      deposito(aux,avIn,caIn,id)
    Informar(p)
  fin
  robot acumulador
  variables 
    id,avIn,caIn,cont1,cont2,cant:numero
  comenzar
    avIn:= PosAv
    caIn:= PosCa
    cont1:=0
    cont2:=0
    EnviarMensaje(1,robot1)
    EnviarMensaje(2,robot2)
    repetir 8
      RecibirMensaje(id,*)
      si (id = 1) 
        RecibirMensaje(cant,robot1)
        cont1:= cont1 + cant
      sino 
        RecibirMensaje(cant,robot2)
        cont2:= cont2 + cant
      BloquearEsquina(50,50)
      Pos(50,50)
      repetir cant
        tomarPapel
      Pos(avIn,caIn)
      LiberarEsquina(50,50)
    si (cont1 > cont2)
      Informar('ROBOT1',cont1)
    sino  
      Informar('ROBOT2',cont2)
  fin
variables
  robot1,robot2:recolector
  robotAcumulador:acumulador
comenzar
  AsignarArea(robot1,area1)
  AsignarArea(robot2,area2)
  AsignarArea(robotAcumulador,areaAcumulador)
  AsignarArea(robot1,deposito)
  AsignarArea(robot2,deposito)
  AsignarArea(robotAcumulador,deposito)
  Iniciar(robot1,1,1)
  Iniciar(robot2,30,1)
  Iniciar(robotAcumulador,100,100)
fin
