programa parcial20v2
procesos 
  proceso voyAbuscar (E cant:numero; E avIn:numero; E caIn:numero)
  comenzar
    BloquearEsquina(50,50)
    Pos(50,50)
    repetir cant
      tomarFlor
    Pos(avIn,caIn)
    LiberarEsquina(50,50)
  fin
  proceso enviarID
  comenzar
    EnviarMensaje(1,robot1)
    EnviarMensaje(2,robot2)
    EnviarMensaje(3,robot3)
  fin
  proceso maximo (E cant:numero; ES max:numero; E id:numero; ES maxID:numero)
  comenzar
    si (cant > max)
      max:= cant
      maxID:= id
  fin
areas
  area1:AreaP(1,1,1,100)
  area2:AreaP(2,1,2,100)
  area3:AreaP(3,1,3,100)
  areaJefe:AreaP(4,1,4,1)
  deposito:AreaC(50,50,50,50)
robots
  robot corredor
  variables
    total,cant,id,avIn,caIn:numero
  comenzar
    RecibirMensaje(id,robotJefe)
    total:=0
    repetir 5
      avIn:= PosAv
      caIn:= PosCa
      Random(cant,4,8)
      voyAbuscar(cant,avIn,caIn)
      repetir cant
        mover
      total:= total + cant
    EnviarMensaje(id,robotJefe)
    EnviarMensaje(total,robotJefe)
  fin
  robot jefe
  variables
    id,max,maxID,cant,f:numero
  comenzar
    f:=0
    max:=0
    enviarID 
    repetir 3
      RecibirMensaje(id,*)
      si (id = 1)
        RecibirMensaje(cant,robot1)
      sino
        si (id = 2)
          RecibirMensaje(cant,robot2)
        sino
          RecibirMensaje(cant,robot3)
      maximo(cant,max,id,maxID)    
    Informar(maxID,max)
    Pos(50,50)
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
    Informar('QUEDAN',f)
  fin
variables
  robot1,robot2,robot3:corredor
  robotJefe:jefe
comenzar
  AsignarArea(robot1,area1)
  AsignarArea(robot2,area2)
  AsignarArea(robot3,area3)
  AsignarArea(robot1,deposito)
  AsignarArea(robot2,deposito)
  AsignarArea(robot3,deposito)
  AsignarArea(robotJefe,areaJefe)
  AsignarArea(robotJefe,deposito)
  Iniciar(robot1,1,1)
  Iniciar(robot2,2,1)
  Iniciar(robot3,3,1)
  Iniciar(robotJefe,4,1)  
fin
